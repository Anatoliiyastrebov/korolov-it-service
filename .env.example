# Скопируйте этот файл в .env и заполните реальными значениями.
# .env коммитить НЕЛЬЗЯ — он в .gitignore.

# IONOS SMTP — параметры из Webmail IONOS / Cockpit IONOS.
# Документация: https://www.ionos.de/hilfe/e-mail/allgemeine-themen/serverdaten-fuer-die-einrichtung-eines-e-mail-kontos/
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=info@korolov-it-service.de
SMTP_PASS=

# Кому уходят уведомления и от кого. Обычно — то же самое:
MAIL_FROM=info@korolov-it-service.de
MAIL_TO=info@korolov-it-service.de
MAIL_SUBJECT=Neue Anfrage über die Website

# Защита от флуда: сколько отправок разрешено с одного IP в минуту.
CONTACT_RATE_LIMIT_PER_MIN=5

# Порт для production-сервера (IONOS обычно сам выставляет PORT).
PORT=8080
HOST=0.0.0.0
